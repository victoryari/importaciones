{
  "theme": "Importaciones ERP - Blue Slate",
  "metadata": {
    "version": "1.0.0",
    "description": "Design system specification extracted from the current Importaciones ERP codebase, optimized for seamless integration of new UI modules.",
    "framework": "React + TypeScript + TailwindCSS"
  },
  "colors": {
    "brand": {
      "primary": "#2563eb",
      "primary_hover": "#1d4ed8",
      "primary_light": "#dbeafe",
      "primary_dark": "#1e3a8a",
      "accent": "#3b82f6"
    },
    "neutral": {
      "background": "#f8fafc",
      "background_alt": "#f1f5f9",
      "panel_bg": "#ffffff",
      "sidebar_bg": "#ffffff",
      "text_primary": "#0f172a",
      "text_secondary": "#475569",
      "text_muted": "#94a3b8",
      "border_light": "#e2e8f0",
      "border_medium": "#cbd5e1"
    },
    "states": {
      "active_menu_bg": "#dbeafe",
      "active_menu_text": "#1e3a8a",
      "hover_bg": "#f1f5f9",
      "tab_active_border": "#2563eb",
      "tab_active_text": "#2563eb",
      "tab_inactive_text": "#64748b",
      "danger_action_text": "#dc2626",
      "danger_action_hover_bg": "#fef2f2"
    },
    "status": {
      "success_bg": "#16a34a",
      "success_text": "#ffffff",
      "success_accent": "#22c55e",
      "warning_bg": "#d97706",
      "warning_text": "#ffffff",
      "danger_bg": "#dc2626",
      "danger_text": "#ffffff"
    }
  },
  "typography": {
    "font_family": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif",
    "scale": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "xxl": "1.5rem"
    },
    "weights": {
      "normal": "400",
      "medium": "500",
      "bold": "700",
      "black": "900"
    },
    "letter_spacing": {
      "normal": "0",
      "widest": "0.1em"
    }
  },
  "spacing": {
    "xs": "0.25rem",
    "sm": "0.5rem",
    "md": "0.75rem",
    "lg": "1rem",
    "xl": "1.5rem",
    "xxl": "2rem"
  },
  "borders": {
    "radius": {
      "sm": "0.375rem",
      "md": "0.5rem",
      "lg": "0.75rem",
      "xl": "1rem",
      "xxl": "1.5rem",
      "xxxl": "2rem"
    },
    "width": {
      "thin": "1px",
      "medium": "2px"
    }
  },
  "shadows": {
    "none": "none",
    "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
    "md": "0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05)",
    "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1)"
  },
  "components": {
    "sidebar": {
      "width": "16rem",
      "background_color": "neutral.sidebar_bg",
      "padding": "spacing.lg",
      "logo_card": {
        "background_color": "brand.primary_dark",
        "text_color": "#ffffff",
        "border_radius": "borders.radius.xxxl",
        "shadow": "shadows.lg shadow-blue-100/50"
      },
      "menu_group_label": {
        "text_color": "neutral.text_muted",
        "text_size": "typography.scale.xs",
        "text_weight": "typography.weights.black",
        "letter_spacing": "typography.letter_spacing.widest",
        "text_transform": "uppercase",
        "padding_y": "spacing.sm"
      },
      "menu_item": {
        "border_radius": "borders.radius.xxl",
        "padding_y": "spacing.md",
        "padding_x": "spacing.lg",
        "text_size": "typography.scale.sm",
        "text_color": "neutral.text_secondary",
        "hover": {
          "background_color": "states.hover_bg",
          "text_color": "neutral.text_primary"
        },
        "active": {
          "background_color": "states.active_menu_bg",
          "text_color": "states.active_menu_text",
          "text_weight": "typography.weights.bold"
        }
      }
    },
    "main_panel": {
      "background_color": "neutral.background_alt",
      "border": "1px solid neutral.border_light",
      "border_radius": "borders.radius.xxl",
      "shadow": "shadows.sm",
      "tab_bar": {
        "border_bottom": "1px solid neutral.border_light",
        "tab": {
          "border_radius_top": "borders.radius.lg",
          "text_size": "typography.scale.sm",
          "text_weight": "typography.weights.bold",
          "active": {
            "border_color": "states.tab_active_border",
            "text_color": "states.tab_active_text",
            "background_color": "neutral.panel_bg"
          },
          "inactive": {
            "border_color": "transparent",
            "text_color": "states.tab_inactive_text",
            "hover": {
              "background_color": "rgba(255, 255, 255, 0.5)",
              "text_color": "neutral.text_primary"
            }
          }
        }
      }
    },
    "notification_banner": {
      "success": {
        "position": "fixed top-24 right-10 z-50",
        "background_color": "status.success_bg",
        "text_color": "status.success_text",
        "border_radius": "borders.radius.xxl",
        "shadow": "shadows.lg",
        "padding_x": "spacing.xl",
        "padding_y": "spacing.md",
        "font_weight": "typography.weights.bold"
      }
    }
  }
}
