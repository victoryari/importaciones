generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Advertisement {
  id             Int      @id @default(autoincrement())
  title          String
  imageUrl       String
  link           String?
  isActive       Boolean  @default(true)
  position       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  mobileImageUrl String?

  @@map("advertisement")
}

model Brand {
  id       Int       @id @default(autoincrement())
  name     String
  logo     String?
  products Product[]

  @@map("brand")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  image       String?   @db.Text
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isFeatured  Boolean   @default(false)
  products    Product[]

  @@map("category")
}

model GlobalSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @db.Text

  @@map("globalsetting")
}

model Product {
  id                    Int             @id @default(autoincrement())
  name                  String
  slug                  String          @unique
  description           String?         @db.Text
  stock                 Int             @default(0)
  images                Json?
  categoryId            Int
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  brandId               Int?
  certificate           String?
  code                  String?         @unique
  costPrice             Decimal         @default(0.00) @db.Decimal(10, 2)
  features              String?         @db.Text
  igv                   Decimal         @default(18.00) @db.Decimal(5, 2)
  isActive              Boolean         @default(true)
  maxSalePrice          Decimal?        @db.Decimal(10, 2)
  minSalePrice          Decimal?        @db.Decimal(10, 2)
  salePrice             Decimal         @default(0.00) @db.Decimal(10, 2)
  sanitaryRegister      String?
  unitId                Int?
  weight                Decimal?        @db.Decimal(10, 4)
  volume                Decimal?        @default(0.00) @db.Decimal(10, 4)
  packageId             Int?
  quantityPerPackage    Int             @default(1)
  quantityPerSubPackage Int             @default(1)
  subPackageId          Int?
  manageLots            Boolean         @default(false)
  showInWeb             Boolean         @default(true)
  useExpiryDate         Boolean         @default(false)
  profitMargin          Decimal         @default(0.00) @db.Decimal(10, 2)
  existenceTypeCode     String?         @default("01")
  valuationMethodCode   String?         @default("1")
  isOnSale              Boolean         @default(false)
  discountPercent       Decimal?        @db.Decimal(5, 2)
  orderItems            OrderItem[]
  brand                 Brand?          @relation(fields: [brandId], references: [id])
  category              Category        @relation(fields: [categoryId], references: [id])
  package               Unit?           @relation("PackageUnit", fields: [packageId], references: [id])
  subPackage            Unit?           @relation("SubPackageUnit", fields: [subPackageId], references: [id])
  unit                  Unit?           @relation("BaseUnit", fields: [unitId], references: [id])
  purchaseItems         PurchaseItem[]
  quotationItems        QuotationItem[]
  invoiceItems          InvoiceItem[]
  stockRecords          Stock[]
  movements             StockMovement[]
  entryNoteItems        EntryNoteItem[]
  salesReferralGuideItems SalesReferralGuideItem[]

  @@index([brandId])
  @@index([categoryId])
  @@index([unitId])
  @@index([packageId], map: "product_packageId_fkey")
  @@index([subPackageId], map: "product_subPackageId_fkey")
  @@map("product")
}

model Warehouse {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  address        String?
  code           String?          @unique
  commercialName String?
  createdAt      DateTime         @default(now())
  isActive       Boolean          @default(true)
  observation    String?          @db.Text
  phones         String?
  ruc            String?
  type           String?
  ubigeo         String?
  sunatCode      String?          @default("0000")
  updatedAt      DateTime         @default(now()) @updatedAt
  validateStock  Boolean          @default(true)
  series         DocumentSeries[]
  stock          Stock[]
  fromMoves      StockMovement[]  @relation("FromWarehouse")
  toMoves        StockMovement[]  @relation("ToWarehouse")
  fromTransfers  Transfer[]       @relation("FromTransfer")
  toTransfers    Transfer[]       @relation("ToTransfer")
  floors         WarehouseFloor[]
  entryNotes     EntryNote[]      @relation("EntryNoteWarehouse")
  invoices       Invoice[]
  users          User[]           @relation("UserWarehouse")
  sellers        Seller[]         @relation("SellerWarehouse")
  salesReferralGuides SalesReferralGuide[]

  @@map("warehouse")
}

model WarehouseFloor {
  id          Int             @id @default(autoincrement())
  code        String?
  name        String
  warehouseId Int
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  zones       WarehouseZone[]
  entryNotes  EntryNote[]

  @@unique([warehouseId, name])
  @@unique([warehouseId, code])
  @@map("warehouse_floor")
}

model WarehouseZone {
  id        Int             @id @default(autoincrement())
  code      String?
  name      String
  floorId   Int
  stock     Stock[]
  fromMoves StockMovement[] @relation("FromZone")
  toMoves   StockMovement[] @relation("ToZone")
  floor     WarehouseFloor  @relation(fields: [floorId], references: [id], onDelete: Cascade)
  entryNotes EntryNote[]

  @@unique([floorId, name])
  @@unique([floorId, code])
  @@map("warehouse_zone")
}

model WarehouseOperator {
  id        Int      @id @default(autoincrement())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  orders    Order[] @relation("OrderPicker")

  @@map("warehouse_operator")
}

model Stock {
  id          Int            @id @default(autoincrement())
  productId   Int
  warehouseId Int
  quantity    Int            @default(0)
  floorId     Int?
  zoneId      Int?
  expiryDate  DateTime?
  lotNumber   String?
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  zone        WarehouseZone? @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId, zoneId, lotNumber])
  @@index([warehouseId], map: "stock_warehouseId_fkey")
  @@index([zoneId], map: "stock_zoneId_fkey")
  @@map("stock")
}

model StockMovement {
  id              Int            @id @default(autoincrement())
  productId       Int
  fromWarehouseId Int?
  toWarehouseId   Int?
  quantity        Int
  orderId         Int?
  purchaseId      Int?
  transferId      Int?
  type            String
  createdAt       DateTime       @default(now())
  fromZoneId      Int?
  toZoneId        Int?
  observation     String?        @db.Text
  lotNumber       String?
  status          String         @default("COMPLETED")
  fromWarehouse   Warehouse?     @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  fromZone        WarehouseZone? @relation("FromZone", fields: [fromZoneId], references: [id])
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  purchase        Purchase?      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  transfer        Transfer?      @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  toWarehouse     Warehouse?     @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  toZone          WarehouseZone? @relation("ToZone", fields: [toZoneId], references: [id])

  @@index([fromWarehouseId], map: "stock_movement_fromWarehouseId_fkey")
  @@index([fromZoneId], map: "stock_movement_fromZoneId_fkey")
  @@index([orderId], map: "stock_movement_orderId_fkey")
  @@index([productId], map: "stock_movement_productId_fkey")
  @@index([toWarehouseId], map: "stock_movement_toWarehouseId_fkey")
  @@index([toZoneId], map: "stock_movement_toZoneId_fkey")
  @@map("stock_movement")
}

model Unit {
  id                 Int       @id @default(autoincrement())
  name               String
  symbol             String
  packageProducts    Product[] @relation("PackageUnit")
  subPackageProducts Product[] @relation("SubPackageUnit")
  products           Product[] @relation("BaseUnit")
  entryNoteItems     EntryNoteItem[]

  @@map("unit")
}

model ExchangeRate {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique @default(now())
  createdAt DateTime @default(now())
  buy_rate  Decimal  @default(1.0000) @db.Decimal(10, 4)
  sell_rate Decimal  @default(1.0000) @db.Decimal(10, 4)

  @@map("exchange_rate")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  permissions String   @db.Text
  isActive    Boolean  @default(true)
  users       User[]

  @@map("role")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  series    String?  @default("F001")
  isActive  Boolean  @default(true)
  roleId    Int?
  role      Role?    @relation(fields: [roleId], references: [id])
  warehouseId Int?
  warehouse   Warehouse? @relation("UserWarehouse", fields: [warehouseId], references: [id])
  dispatches Dispatch[]

  @@index([roleId])
  @@index([warehouseId])
  @@map("user")
}

model SunatTable {
  id          Int     @id @default(autoincrement())
  tableName   String
  code        String
  name        String
  description String? @db.Text
  isActive    Boolean @default(true)

  @@unique([tableName, code])
  @@map("sunat_table")
}

model DocumentType {
  id   Int    @id @default(autoincrement())
  name String @unique
  code String @unique

  @@map("document_type")
}

model Customer {
  id         Int         @id @default(autoincrement())
  code       String?     @unique
  name       String
  docType    String      @default("DNI")
  docNumber  String      @unique
  address    String?     @db.Text
  phone      String?
  email      String?
  contact    String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  country    String?     @default("PERU")
  department String?
  district   String?
  firstName  String?
  lastName   String?
  personType String      @default("NATURAL")
  province   String?
  secondName String?
  surname    String?
  orders     Order[]
  quotations Quotation[]
  invoices   Invoice[]
  salesReferralGuides SalesReferralGuide[]

  @@map("customer")
}

model Supplier {
  id        Int        @id @default(autoincrement())
  code      String?    @unique
  name      String
  docType   String     @default("RUC")
  docNumber String     @unique
  address   String?    @db.Text
  phone     String?
  email     String?
  contact   String?
  department String?
  province   String?
  district   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases  Purchase[]
  entryNotes EntryNote[]

  @@map("supplier")
}

model Seller {
  id         Int         @id @default(autoincrement())
  name       String
  dni        String?     @unique
  phone      String?
  email      String?
  isActive   Boolean     @default(true)
  warehouseId Int?
  warehouse   Warehouse?  @relation("SellerWarehouse", fields: [warehouseId], references: [id])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orders     Order[]
  quotations Quotation[]
  invoices   Invoice[]

  @@index([warehouseId])
  @@map("seller")
}

model Quotation {
  id                Int             @id @default(autoincrement())
  customerName      String
  customerPhone     String
  customerEmail     String?
  totalAmount       Decimal         @default(0.00) @db.Decimal(10, 2)
  status            String          @default("PENDING")
  notes             String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  currency          String?         @default("PEN")
  customerAddress   String?
  customerDocNumber String?
  customerDocType   String?
  paymentCondition  String?         @default("CONTADO")
  customerId        Int?
  docNumber         String?
  docSeries         String?
  docType           String          @default("COT")
  dueDate           DateTime?
  exchangeRate      Decimal         @default(1.000) @db.Decimal(10, 3)
  includeIgv        Boolean         @default(true)
  operationType     String?         @default("10")
  sellerName        String?
  agencyId          Int?
  branchId          Int?
  billingStatus     String?         @default("SIN FACTURAR")
  flete             Decimal         @default(0.00) @db.Decimal(10, 2)
  globalDiscount    Decimal         @default(0.00) @db.Decimal(10, 2)
  igvPercent        Decimal         @default(18.00) @db.Decimal(5, 2)
  internalCode      String?
  observation       String?         @db.Text
  pickupPlace       String?
  priceIncludesIgv  Boolean         @default(true)
  sellerId          Int?
  orders            Order[]
  agency            ShippingAgency? @relation(fields: [agencyId], references: [id])
  branch            AgencyBranch?   @relation(fields: [branchId], references: [id])
  customer          Customer?       @relation(fields: [customerId], references: [id])
  seller            Seller?         @relation(fields: [sellerId], references: [id])
  items             QuotationItem[]

  @@index([agencyId], map: "quotation_agencyId_fkey")
  @@index([branchId], map: "quotation_branchId_fkey")
  @@index([customerId], map: "quotation_customerId_fkey")
  @@index([sellerId], map: "quotation_sellerId_fkey")
  @@map("quotation")
}

model QuotationItem {
  id          Int       @id @default(autoincrement())
  quotationId Int
  productId   Int
  quantity    Int
  price       Decimal   @db.Decimal(10, 2)
  discount    Decimal   @default(0.00) @db.Decimal(10, 2)
  lotNumber   String?
  warehouseName String?
  expiryDate  DateTime?
  unitMeasure String?
  product     Product   @relation(fields: [productId], references: [id], map: "quotation_item_product_id_fkey_new")
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([productId], map: "quotation_item_product_id_fkey_new")
  @@index([quotationId], map: "quotation_item_quotationId_fkey")
  @@map("quotation_item")
}

model Order {
  id                 Int             @id @default(autoincrement())
  customerName       String
  customerEmail      String?
  customerPhone      String
  customerCity       String?
  customerAddress    String?         @db.Text
  totalAmount        Decimal         @default(0.00) @db.Decimal(10, 2)
  status             String          @default("PENDING")
  notes              String?         @db.Text
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  agencyId           Int?
  branchId           Int?
  carrierGuide       String?
  paymentStatus      String          @default("UNPAID")
  quotationId        Int?
  referralGuide      String?
  shippingCost       Decimal         @default(0.00) @db.Decimal(10, 2)
  voucherNumber      String?
  currency           String?         @default("PEN")
  customerDocNumber  String?
  customerDocType    String?
  paymentCondition   String?         @default("CONTADO")
  consigneeAddress   String?
  consigneeDocNumber String?
  consigneeName      String?
  consigneePhone     String?
  customerId         Int?
  docNumber          String?
  docSeries          String?
  docType            String          @default("COT")
  dueDate            DateTime?
  exchangeRate       Decimal         @default(1.000) @db.Decimal(10, 3)
  includeIgv         Boolean         @default(true)
  pickupPlace        String?
  purchaseOrder      String?
  requirementNumber  String?
  sellerName         String?
  sellerId           Int?
  agency             ShippingAgency? @relation(fields: [agencyId], references: [id], map: "order_agency_fkey_manual")
  branch             AgencyBranch?   @relation(fields: [branchId], references: [id], map: "order_branch_fkey_manual")
  customer           Customer?       @relation(fields: [customerId], references: [id])
  quotation          Quotation?      @relation(fields: [quotationId], references: [id], map: "order_quotation_fkey_manual")
  seller             Seller?         @relation(fields: [sellerId], references: [id])
  items              OrderItem[]
  payments           Payment[]
  movements          StockMovement[]
  invoices           Invoice[]
  salesReferralGuides SalesReferralGuide[]
  origin             String          @default("ADMIN")
  warehouseStatus    String?         
  pickerId           Int?
  picker             WarehouseOperator? @relation("OrderPicker", fields: [pickerId], references: [id])
  pickingStartedAt   DateTime?
  dispatchId         Int?
  dispatch           Dispatch?       @relation(fields: [dispatchId], references: [id])
  deliveredAt        DateTime?

  @@index([agencyId], map: "order_agency_fkey_manual")
  @@index([branchId], map: "order_branch_fkey_manual")
  @@index([customerId], map: "order_customerId_fkey")
  @@index([quotationId], map: "order_quotation_fkey_manual")
  @@index([sellerId], map: "order_sellerId_fkey")
  @@index([dispatchId], map: "order_dispatchId_fkey")
  @@map("order")
}

model Payment {
  id            Int      @id @default(autoincrement())
  orderId       Int
  amount        Decimal  @db.Decimal(10, 2)
  method        String
  voucherNumber String?
  date          DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id])

  @@index([orderId], map: "payment_orderId_fkey")
  @@map("payment")
}

model ShippingZone {
  id       Int              @id @default(autoincrement())
  name     String           @unique
  baseRate Decimal          @default(0.00) @db.Decimal(10, 2)
  agencies ShippingAgency[]

  @@map("shipping_zone")
}

model ShippingAgency {
  id           Int            @id @default(autoincrement())
  name         String
  address      String?
  zoneId       Int
  contact      String?
  country      String?        @default("PERU")
  department   String?
  district     String?
  email        String?
  isActive     Boolean        @default(true)
  phone        String?
  province     String?
  ruc          String?
  ubigeo       String?
  legalAddress String?        @db.Text
  branches     AgencyBranch[]
  orders       Order[]
  quotations   Quotation[]
  salesReferralGuides SalesReferralGuide[]
  zone         ShippingZone   @relation(fields: [zoneId], references: [id])

  @@index([zoneId], map: "shipping_agency_zoneId_fkey")
  @@map("shipping_agency")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  discount  Decimal @default(0.00) @db.Decimal(10, 2)
  lotNumber   String?
  warehouseName String?
  expiryDate  DateTime?
  unitMeasure String?
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_item")
}

model AgencyBranch {
  id         Int            @id @default(autoincrement())
  agencyId   Int
  address    String         @db.Text
  department String?
  province   String?
  district   String?
  ubigeo     String?
  contact    String?
  phone      String?
  isMain     Boolean        @default(false)
  agency     ShippingAgency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  quotations Quotation[]
  orders     Order[]

  @@index([agencyId], map: "agency_branch_agencyId_fkey")
  @@map("agency_branch")
}

model DocumentSeries {
  id            Int       @id @default(autoincrement())
  documentType  String
  series        String
  currentNumber Int       @default(0)
  warehouseId   Int
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([documentType, series, warehouseId])
  @@index([warehouseId], map: "document_series_warehouseId_fkey")
  @@map("document_series")
}

model Purchase {
  id               Int            @id @default(autoincrement())
  supplierId       Int
  supplierName     String
  referenceId      Int?
  docType          String         @default("FACTURA")
  docSeries        String?
  docNumber        String?
  date             DateTime       @default(now())
  currency         String         @default("PEN")
  exchangeRate     Decimal        @default(1.000) @db.Decimal(10, 3)
  totalAmount      Decimal        @default(0.00) @db.Decimal(10, 2)
  status           String         @default("COMPLETED")
  warehouseId      Int?
  purchaseType     String         @default("NACIONAL")
  paymentCondition String?        @default("CONTADO")
  creditDays       Int?           @default(0)
  observation      String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  supplier         Supplier       @relation(fields: [supplierId], references: [id])
  reference        Purchase?      @relation("PurchaseReference", fields: [referenceId], references: [id])
  referencedBy     Purchase[]     @relation("PurchaseReference")
  items            PurchaseItem[]
  movements        StockMovement[]

  @@index([supplierId], map: "purchase_supplierId_fkey")
  @@map("purchase")
}

model PurchaseItem {
  id             Int       @id @default(autoincrement())
  purchaseId     Int
  productId      Int
  quantity       Int
  price          Decimal   @db.Decimal(10, 2)
  isFree         Boolean   @default(false)
  freeType       String?   @db.VarChar(10)
  referencePrice Decimal?  @default(0.00) @db.Decimal(10, 2)
  expiryDate     DateTime?
  lotNumber      String?
  seriesNumber   String?
  unitSymbol     String?   @db.VarChar(20)
  observation    String?   @db.Text
  product        Product   @relation(fields: [productId], references: [id])
  purchase       Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([productId], map: "purchase_item_productId_fkey")
  @@index([purchaseId], map: "purchase_item_purchaseId_fkey")
  @@map("purchase_item")
}

model Transfer {
  id              Int            @id @default(autoincrement())
  fromWarehouseId Int
  toWarehouseId   Int
  docNumber       String?
  date            DateTime       @default(now())
  observation     String?        @db.Text
  status          String         @default("COMPLETED")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  fromWarehouse   Warehouse      @relation("FromTransfer", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse      @relation("ToTransfer", fields: [toWarehouseId], references: [id])
  items           TransferItem[]
  movements       StockMovement[]

  @@index([fromWarehouseId], map: "transfer_fromWarehouseId_fkey")
  @@index([toWarehouseId], map: "transfer_toWarehouseId_fkey")
  @@map("transfer")
}

model TransferItem {
  id         Int      @id @default(autoincrement())
  transferId Int
  productId  Int
  quantity   Int
  transfer   Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId], map: "transfer_item_transferId_fkey")
  @@map("transfer_item")
}

model Invoice {
  id                Int                  @id @default(autoincrement())
  documentType      String               // FACT, BOOL, NCRE
  series            String               // F001, B001
  number            Int                  // correlativo numérico
  numberFormatted   String               // F001-00000123

  customerId        Int?
  customerName      String
  customerDocType   String
  customerDocNumber String
  customerAddress   String?              @db.Text
  customerEmail     String?
  customerPhone     String?

  issueDate         DateTime             @default(now())
  dueDate           DateTime?
  currency          String               @default("PEN")
  exchangeRate      Decimal              @default(1.000) @db.Decimal(10, 3)
  paymentCondition  String               @default("CONTADO")
  operationType     String?              @default("10")
  includeIgv        Boolean              @default(true)
  priceIncludesIgv  Boolean              @default(true)
  igvPercent        Decimal              @default(18.00) @db.Decimal(5, 2)

  totalAmount       Decimal              @default(0.00) @db.Decimal(12, 2)
  totalIgv          Decimal              @default(0.00) @db.Decimal(12, 2)
  subtotal          Decimal              @default(0.00) @db.Decimal(12, 2)

  status            String               @default("ACTIVE")
  billingStatus     String               @default("PENDIENTE")

  warehouseId       Int?
  warehouse         Warehouse?           @relation(fields: [warehouseId], references: [id])
  sunatEstablishmentCode String?         @default("0000")
  sunatStatus       String               @default("PENDING") // PENDING, ACCEPTED, REJECTED, OBSERVED, VOIDED
  sunatResponse     String?              @db.Text
  sunatCdrUrl       String?
  sunatCdrXml       String?              @db.Text
  sunatXmlUrl       String?
  sunatPdfUrl       String?
  sunatHashCode     String?
  sunatQr           String?              @db.Text

  sellerId          Int?
  seller            Seller?              @relation(fields: [sellerId], references: [id])
  customer          Customer?            @relation(fields: [customerId], references: [id])
  orderId           Int?
  order             Order?               @relation(fields: [orderId], references: [id])

  notes             String?              @db.Text

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  items             InvoiceItem[]
  installments      InvoiceInstallment[]
  salesReferralGuides SalesReferralGuide[]

  @@index([customerId])
  @@index([orderId])
  @@index([sellerId])
  @@index([warehouseId])
  @@map("invoice")
}

model InvoiceItem {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  productId   Int
  quantity    Int
  unitMeasure String   @default("UND")
  price       Decimal  @db.Decimal(12, 6)
  discount    Decimal  @default(0.00) @db.Decimal(10, 2)
  priceType   String   @default("PRICE1")
  total       Decimal  @db.Decimal(12, 2)
  lotNumber   String?

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_item")
}

model InvoiceInstallment {
  id         Int      @id @default(autoincrement())
  invoiceId  Int
  number     Int
  amount     Decimal  @db.Decimal(12, 2)
  daysOffset Int
  dueDate    DateTime
  status     String   @default("PENDING")
  paidDate   DateTime?

  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_installment")
}

model EntryNote {
  id              Int             @id @default(autoincrement())
  warehouseId     Int
  zoneId          Int?
  floorId         Int?
  currency        String          @default("PEN")
  exchangeRate    Decimal         @default(1.0000) @db.Decimal(10, 4)
  supplierId      Int?
  date            DateTime
  description     String?         @db.Text
  reasonCode      String
  guideRemission  String?
  status          String          @default("DRAFT")
  documentType    String?
  series          String?
  number          String?
  totalAmount     Decimal         @default(0.00) @db.Decimal(12, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  items           EntryNoteItem[]
  warehouse       Warehouse       @relation("EntryNoteWarehouse", fields: [warehouseId], references: [id])
  supplier        Supplier?       @relation(fields: [supplierId], references: [id])
  zone            WarehouseZone?  @relation(fields: [zoneId], references: [id])
  floor           WarehouseFloor? @relation(fields: [floorId], references: [id])

  @@index([warehouseId])
  @@index([supplierId])
  @@index([zoneId])
  @@index([floorId])
  @@index([status])
  @@index([date])
  @@map("entry_note")
}

model EntryNoteItem {
  id              Int       @id @default(autoincrement())
  entryNoteId     Int
  productId       Int
  guideRemission  String?
  documentType    String?
  documentNumber  String?
  quantity        Int
  unitId          Int
  unitCost        Decimal   @db.Decimal(12, 4)
  total           Decimal   @db.Decimal(12, 2)
  orderNumber     String?
  lotNumber       String?
  entryDate       DateTime
  weight          Decimal?  @db.Decimal(10, 4)
  totalWeight     Decimal?  @db.Decimal(10, 4)
  product         Product   @relation(fields: [productId], references: [id])
  unit            Unit      @relation(fields: [unitId], references: [id])
  entryNote       EntryNote @relation(fields: [entryNoteId], references: [id], onDelete: Cascade)

  @@index([entryNoteId])
  @@index([productId])
  @@map("entry_note_item")
}

model Vehicle {
  id             Int        @id @default(autoincrement())
  plate          String     @unique
  brand          String?
  model          String?
  capacityWeight Decimal    @default(0.00) @db.Decimal(10, 2) // en KG
  capacityVolume Decimal    @default(0.00) @db.Decimal(10, 2) // en m3
  status         String     @default("ACTIVE") // ACTIVE, MAINTENANCE, INACTIVE
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  dispatches     Dispatch[]

  @@map("vehicle")
}

model Driver {
  id             Int       @id @default(autoincrement())
  docType        String    @default("1")
  docNumber      String    @unique
  name           String
  licenseNumber  String?
  phone          String?
  email          String?
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("driver")
}

model Dispatch {
  id               Int       @id @default(autoincrement())
  vehicleId        Int
  driverId         Int?
  driverName       String?
  departureDate    DateTime?
  estimatedArrival DateTime?
  status           String    @default("PENDING") // PENDING, LOADING, IN_TRANSIT, DELIVERED
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  vehicle          Vehicle   @relation(fields: [vehicleId], references: [id])
  driver           User?     @relation(fields: [driverId], references: [id])
  orders           Order[]

  @@index([vehicleId])
  @@index([driverId])
  @@map("dispatch")
}

model SalesReferralGuide {
  id                        Int                         @id @default(autoincrement())
  documentType              String                      @default("09")
  series                    String
  number                    Int
  numberFormatted           String
  
  issueDate                 DateTime                    @default(now())
  transferDate              DateTime                    @default(now())
  
  transferReason            String                      @default("01")
  transferReasonDescription String?                     @default("VENTA")
  transportMode             String                      @default("02")
  
  // Destinatario
  customerId                Int?
  customerDocType           String                      @default("RUC")
  customerDocNumber         String
  customerName              String
  customerAddress           String?                     @db.Text
  
  // Punto de Partida
  originWarehouseId         Int?
  originAddress             String                      @db.Text
  originUbigeo              String?                     @default("150101")
  originSunatCode           String?                     @default("0000")
  
  // Punto de Llegada
  deliveryAddress           String                      @db.Text
  deliveryUbigeo            String?                     @default("150101")
  deliveryDepartment        String?
  deliveryProvince          String?
  deliveryDistrict          String?
  
  // Transporte Público
  carrierDocType            String?                     @default("6")
  carrierDocNumber          String?
  carrierName               String?
  carrierMtcNumber          String?
  shippingAgencyId          Int?
  shippingBranchId          Int?
  
  // Transporte Privado
  driverDocType             String?                     @default("1")
  driverDocNumber           String?
  driverName                String?
  driverLicenseNumber       String?
  vehiclePlate              String?
  vehicleSecondaryPlate     String?
  
  // Carga
  totalWeight               Decimal                     @default(0.00) @db.Decimal(10, 2)
  weightUnit                String                      @default("KGM")
  totalPackages             Int                         @default(1)
  
  // Documentos Relacionados
  orderId                   Int?
  orderNumber               String?
  invoiceId                 Int?
  invoiceNumber             String?
  relatedDocType            String?
  relatedDocNumber          String?
  
  // Estado y SUNAT
  status                    String                      @default("ACTIVE")
  sunatStatus               String                      @default("PENDING")
  sunatResponse             String?                     @db.Text
  sunatCdrUrl               String?
  sunatCdrXml               String?                     @db.Text
  sunatXmlUrl               String?
  sunatPdfUrl               String?
  sunatHashCode             String?
  sunatQr                   String?                     @db.Text
  
  notes                     String?                     @db.Text
  
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  
  items                     SalesReferralGuideItem[]
  
  customer                  Customer?                   @relation(fields: [customerId], references: [id])
  originWarehouse           Warehouse?                  @relation(fields: [originWarehouseId], references: [id])
  order                     Order?                      @relation(fields: [orderId], references: [id])
  invoice                   Invoice?                    @relation(fields: [invoiceId], references: [id])
  shippingAgency            ShippingAgency?             @relation(fields: [shippingAgencyId], references: [id])

  @@index([customerId])
  @@index([originWarehouseId])
  @@index([orderId])
  @@index([invoiceId])
  @@index([shippingAgencyId])
  @@map("sales_referral_guide")
}

model SalesReferralGuideItem {
  id                        Int                         @id @default(autoincrement())
  referralGuideId           Int
  productId                 Int
  code                      String?
  description               String
  quantity                  Decimal                     @db.Decimal(10, 2)
  unitMeasure               String                      @default("NIU")
  unitWeight                Decimal?                    @default(0.00) @db.Decimal(10, 3)
  totalWeight               Decimal?                    @default(0.00) @db.Decimal(10, 2)
  lotNumber                 String?
  expiryDate                DateTime?
  
  referralGuide             SalesReferralGuide          @relation(fields: [referralGuideId], references: [id], onDelete: Cascade)
  product                   Product                     @relation(fields: [productId], references: [id])
  
  @@index([referralGuideId])
  @@index([productId])
  @@map("sales_referral_guide_item")
}
