generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Advertisement {
  id        Int      @id @default(autoincrement())
  title     String
  imageUrl       String
  mobileImageUrl String?
  link           String?
  isActive       Boolean  @default(true)
  position       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("advertisement")
}

model Brand {
  id       Int       @id @default(autoincrement())
  name     String
  logo     String?
  products Product[]

  @@map("brand")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  image       String?   @db.Text
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isFeatured  Boolean   @default(false)
  products    Product[]

  @@map("category")
}

model GlobalSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @db.Text

  @@map("globalsetting")
}

model Product {
  id               Int             @id @default(autoincrement())
  name             String
  slug             String          @unique
  description      String?         @db.Text
  stock            Int             @default(0)
  images           Json?
  categoryId       Int
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  brandId          Int?
  certificate      String?
  code             String?         @unique
  costPrice        Decimal         @default(0.00) @db.Decimal(10, 2)
  features         String?         @db.Text
  igv              Decimal         @default(18.00) @db.Decimal(5, 2)
  isActive         Boolean         @default(true)
  maxSalePrice     Decimal?        @db.Decimal(10, 2)
  minSalePrice     Decimal?        @db.Decimal(10, 2)
  salePrice        Decimal         @default(0.00) @db.Decimal(10, 2)
  sanitaryRegister String?
  unitId           Int?
  weight           Decimal?        @db.Decimal(10, 3)
  volume           Decimal?        @db.Decimal(10, 3)
  orderItems       OrderItem[]
  quotationItems   QuotationItem[]
  stockRecords     Stock[]
  movements        StockMovement[]
  brand            Brand?          @relation(fields: [brandId], references: [id])
  category         Category        @relation(fields: [categoryId], references: [id])
  unit                   Unit?           @relation("BaseUnit", fields: [unitId], references: [id])
  packageId              Int?
  package                Unit?           @relation("PackageUnit", fields: [packageId], references: [id])
  quantityPerPackage     Int             @default(1)
  subPackageId           Int?
  subPackage             Unit?           @relation("SubPackageUnit", fields: [subPackageId], references: [id])
  quantityPerSubPackage  Int             @default(1)
  
  // New Visibility and Control Fields
  showInWeb              Boolean         @default(true)
  manageLots             Boolean         @default(false)
  useExpiryDate          Boolean         @default(false)

  @@index([brandId])
  @@index([categoryId])
  @@index([unitId])
  @@map("product")
}

model Warehouse {
  id              Int              @id @default(autoincrement())
  code            String?          @unique
  name            String           @unique // Existencias, Comprobante, Despacho
  commercialName  String?
  address         String?
  ruc             String?
  ubigeo          String?
  observation     String?          @db.Text
  phones          String?
  type            String?          // PRINCIPAL, DESPACHO, COMPROBANTES, etc.
  validateStock   Boolean          @default(true)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt

  stock           Stock[]
  fromMoves       StockMovement[]  @relation("FromWarehouse")
  toMoves         StockMovement[]  @relation("ToWarehouse")
  series          DocumentSeries[]
  floors          WarehouseFloor[]

  @@map("warehouse")
}

model WarehouseFloor {
  id          Int             @id @default(autoincrement())
  code        String?
  name        String
  warehouseId Int
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  zones       WarehouseZone[]

  @@unique([warehouseId, name])
  @@unique([warehouseId, code])
  @@map("warehouse_floor")
}

model WarehouseZone {
  id          Int             @id @default(autoincrement())
  code        String?
  name        String
  floorId     Int
  floor       WarehouseFloor  @relation(fields: [floorId], references: [id], onDelete: Cascade)
  stock       Stock[]
  fromMoves   StockMovement[] @relation("FromZone")
  toMoves     StockMovement[] @relation("ToZone")

  @@unique([floorId, name])
  @@unique([floorId, code])
  @@map("warehouse_zone")
}

model Stock {
  id          Int            @id @default(autoincrement())
  productId   Int
  warehouseId Int
  floorId     Int?           // Referencial
  zoneId      Int?           // Ubicación específica
  quantity    Int            @default(0)
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  zone        WarehouseZone? @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId, zoneId])
  @@map("stock")
}

model StockMovement {
  id              Int            @id @default(autoincrement())
  productId       Int
  fromWarehouseId Int?
  toWarehouseId   Int?
  fromZoneId      Int?
  toZoneId        Int?
  quantity        Int
  orderId         Int?
  type            String         // TRANSFER, ADJUSTMENT, INITIAL
  createdAt       DateTime       @default(now())
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromWarehouse   Warehouse?     @relation("FromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: SetNull)
  toWarehouse     Warehouse?     @relation("ToWarehouse", fields: [toWarehouseId], references: [id], onDelete: SetNull)
  fromZone        WarehouseZone? @relation("FromZone", fields: [fromZoneId], references: [id], onDelete: SetNull)
  toZone          WarehouseZone? @relation("ToZone", fields: [toZoneId], references: [id], onDelete: SetNull)
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("stock_movement")
}

model Unit {
  id       Int       @id @default(autoincrement())
  name     String
  symbol   String
  products           Product[] @relation("BaseUnit")
  packageProducts    Product[] @relation("PackageUnit")
  subPackageProducts Product[] @relation("SubPackageUnit")

  @@map("unit")
}

model ExchangeRate {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique @default(now())
  buy_rate  Decimal  @default(1.0000) @db.Decimal(10, 4)
  sell_rate Decimal  @default(1.0000) @db.Decimal(10, 4)
  createdAt DateTime @default(now())

  @@map("exchange_rate")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  series    String?  @default("F001")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

model SunatTable {
  id          Int      @id @default(autoincrement())
  tableName   String   // document_type, currency, payment_condition, etc.
  code        String   
  name        String   
  description String?  @db.Text
  isActive    Boolean  @default(true)

  @@unique([tableName, code])
  @@map("sunat_table")
}

model DocumentType {
  id    Int    @id @default(autoincrement())
  name  String @unique // DNI, RUC, Pasaporte, etc.
  code  String @unique // 01, 06, etc. (SUNAT codes)

  @@map("document_type")
}

model Customer {
  id          Int         @id @default(autoincrement())
  code        String?     @unique
  name        String      // Razón Social / Nombre Completo
  personType  String      @default("NATURAL") // NATURAL, JURIDICA
  docType     String      @default("DNI")
  docNumber   String      @unique
  
  firstName   String?
  secondName  String?
  lastName    String?     // Apellido Paterno
  surname     String?     // Apellido Materno
  
  address     String?     @db.Text
  phone       String?
  email       String?
  contact     String?
  
  country     String?     @default("PERU")
  department  String?     // Departamento
  province    String?     // Provincia
  district    String?     // Distrito
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  quotations  Quotation[]
  orders      Order[]

  @@map("customer")
}

model Seller {
  id        Int         @id @default(autoincrement())
  name      String      
  dni       String?     @unique
  phone     String?
  email     String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  quotations Quotation[]
  orders     Order[]

  @@map("seller")
}

model Quotation {
  id                Int             @id @default(autoincrement())
  customerId        Int?
  customerName      String
  customerPhone     String
  customerEmail     String?
  customerDocType   String?
  customerDocNumber String?
  customerAddress   String?
  
  docType           String          @default("COT")
  docSeries         String?
  docNumber         String?
  internalCode      String?         // Código correlativo interno
  igvPercent        Decimal         @default(18.00) @db.Decimal(5, 2)
  exchangeRate      Decimal         @default(1.00) @db.Decimal(10, 3)
  dueDate           DateTime?
  sellerId          Int?
  sellerName        String?
  includeIgv        Boolean         @default(true)
  priceIncludesIgv  Boolean         @default(true)
  operationType     String?         @default("10") // 10 | Gravado
  
  paymentCondition  String?         @default("CONTADO")
  currency          String?         @default("PEN")
  totalAmount       Decimal         @default(0.00) @db.Decimal(10, 2)
  globalDiscount    Decimal         @default(0.00) @db.Decimal(10, 2)
  flete             Decimal         @default(0.00) @db.Decimal(10, 2)
  status            String          @default("PENDING")
  billingStatus     String?         @default("SIN FACTURAR")
  pickupPlace       String?
  observation       String?         @db.Text
  notes             String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  customer          Customer?       @relation(fields: [customerId], references: [id])
  seller            Seller?         @relation(fields: [sellerId], references: [id])
  items             QuotationItem[]
  orders            Order[]
  agency            ShippingAgency? @relation(fields: [agencyId], references: [id])
  agencyId          Int?

  @@map("quotation")
}

model QuotationItem {
  id          Int       @id @default(autoincrement())
  quotationId Int
  productId   Int
  quantity    Int
  price       Decimal   @db.Decimal(10, 2)
  discount    Decimal   @default(0.00) @db.Decimal(10, 2)
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], map: "quotation_item_product_id_fkey_new")

  @@map("quotation_item")
}

model Order {
  id                Int             @id @default(autoincrement())
  quotationId       Int?
  customerId        Int?
  customerName      String
  customerEmail     String?
  customerPhone     String
  customerDocType   String?
  customerDocNumber String?
  customerCity      String?
  customerAddress   String?         @db.Text
  
  docType           String          @default("COT")
  docSeries         String?
  docNumber         String?
  exchangeRate      Decimal         @default(1.00) @db.Decimal(10, 3)
  dueDate           DateTime?
  sellerId          Int?
  sellerName        String?
  includeIgv        Boolean         @default(true)
  purchaseOrder     String?         // Orden de Compra
  requirementNumber String?         // Nro Requerimiento
  
  consigneeName     String?         // Consignatario
  consigneePhone    String?
  consigneeDocNumber String?
  consigneeAddress  String?
  
  paymentCondition  String?         @default("CONTADO")
  currency          String?         @default("PEN")
  totalAmount       Decimal         @default(0.00) @db.Decimal(10, 2)
  status            String          @default("PENDING")
  paymentStatus     String          @default("UNPAID")
  shippingCost      Decimal         @default(0.00) @db.Decimal(10, 2)
  agencyId          Int?
  voucherNumber     String?
  referralGuide     String?
  carrierGuide      String?
  pickupPlace       String?
  
  notes             String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  customer          Customer?       @relation(fields: [customerId], references: [id])
  seller            Seller?         @relation(fields: [sellerId], references: [id])
  items             OrderItem[]
  payments          Payment[]
  movements         StockMovement[]
  quotation         Quotation?      @relation(fields: [quotationId], references: [id])
  agency            ShippingAgency? @relation(fields: [agencyId], references: [id])

  @@map("order")
}

model Payment {
  id            Int      @id @default(autoincrement())
  orderId       Int
  amount        Decimal  @db.Decimal(10, 2)
  method        String
  voucherNumber String?
  date          DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id])

  @@map("payment")
}

model ShippingZone {
  id       Int              @id @default(autoincrement())
  name     String           @unique
  baseRate Decimal          @default(0.00) @db.Decimal(10, 2)
  agencies ShippingAgency[]

  @@map("shipping_zone")
}

model ShippingAgency {
  id          Int          @id @default(autoincrement())
  name        String
  ruc         String?
  address     String?
  legalAddress String?    @db.Text
  phone       String?
  email       String?
  contact     String?
  
  country     String?      @default("PERU")
  department  String?      // Departamento
  province    String?      // Provincia
  district    String?      // Distrito
  ubigeo      String?      // Ubigeo
  
  isActive    Boolean      @default(true)
  zoneId      Int
  orders      Order[]
  quotations  Quotation[]
  branches    AgencyBranch[]
  zone        ShippingZone @relation(fields: [zoneId], references: [id])

  @@map("shipping_agency")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  discount  Decimal @default(0.00) @db.Decimal(10, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_item")
}

model AgencyBranch {
  id          Int            @id @default(autoincrement())
  agencyId    Int
  address     String         @db.Text
  department  String?
  province    String?
  district    String?
  ubigeo      String?
  contact     String?
  phone       String?
  isMain      Boolean        @default(false)
  agency      ShippingAgency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@map("agency_branch")
}

model DocumentSeries {
  id           Int        @id @default(autoincrement())
  documentType String     // COT, PED, FACT, BOOL
  series       String     // 001, 002, F001
  currentNumber Int       @default(0)
  warehouseId  Int
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  warehouse    Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([documentType, series, warehouseId])
  @@map("document_series")
}
